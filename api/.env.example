# Backend CJ_OS Core API
# Copiar este archivo como api/.env y completar las credenciales reales.
# NUNCA subir api/.env al repositorio.

# App
APP_NAME=CJ_OS Core API
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# Seguridad JWT (generar con: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=cambiar_por_clave_jwt_segura_de_64_caracteres_minimo
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Token para tareas automatizadas (snapshot de inventario, scripts, etc.)
SERVICE_TOKEN=cambiar_por_token_de_servicio_seguro

# CORS: orígenes permitidos para la web
CORS_ORIGINS=http://localhost:5173,https://3psadecv.com

# PostgreSQL (cj_assistant)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cj_assistant
POSTGRES_USER=cj_user
POSTGRES_PASSWORD=cambiar_en_env_local

# SQLite local para usuarios del portal (ignorado por git).
# Recomendado usar ruta absoluta en Windows para evitar confusiones con el CWD.
USERS_DB_PATH=G:/Mi unidad/pagina web/3p-website/api/data/users.db

# San Antonio — Excel maestro (SOLO LECTURA)
SAN_ANTONIO_EXCEL_PATH=C:/Users/Ventas-3P/Desktop/SAN ANTONIO/SAN_ANTONIO_SEGUIMIENTO.xlsx

# Vales de almacén — Excel maestro (SOLO LECTURA)
VALES_EXCEL_PATH=Y:/ALMACEN/Mejora Continua ALMACEN/Nuevo Control de Almacen/BASE DE DATOS/BD_ALMACEN_3P.xlsx

# Pedidos pendientes por facturar — Excel maestro (SOLO LECTURA)
PEDIDOS_PENDIENTES_FACTURAR_EXCEL_PATH=Y:/1 - CONTROL DE ALMACEN/BASES DE DATOS/BD pedidos pendientes por facturar.xlsx

# Historial de ventas / facturación — Excel maestro (SOLO LECTURA)
VENTAS_FACTURACION_EXCEL_PATH=Y:/1 - CONTROL DE ALMACEN/BASES DE DATOS/VENTAS_FACTURACION_BASE.xlsx

# Cotizador 2.0 — Excel de vendedores/firmas (SOLO LECTURA)
COTIZADOR_VENDEDORES_EXCEL_PATH=Y:/COTIZACIONES/1. COTIZADOR/2. COTIZADOR 2.0.xlsm

# Sync Excel -> SQLite (Fase 2). true = vales/pedidos se leen de las tablas
# sync_* (job programado); false = lectura en vivo del Excel (default).
# Para revertir basta poner false y reiniciar el backend.
USE_SYNC_TABLES=false

# Logo para reportes de analytics (ruta relativa a api/ o absoluta)
ANALYTICS_LOGO_PATH=../public/images/logo-3p-header.png

# Alertas avanzadas de analytics (OPCIONAL)
# Países considerados esperados (separados por coma). Vacío = sin alerta de país.
ALERTAS_PAISES_PERMITIDOS=México,Colombia
# Notificación por correo. Si SMTP_HOST o ALERTAS_EMAIL_TO están vacíos,
# las alertas solo se muestran en el panel (sin envío de correo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# STARTTLS en puertos no-465 (false solo para relays internos de confianza)
SMTP_TLS=true
ALERTAS_EMAIL_TO=
