# NUNCA subir .env.local al repositorio.

# ---------------------------------------------------------------------------
# Frontend React / Vite
# ---------------------------------------------------------------------------

# URL base de la API de CJ_OS Core (FastAPI)
# - Desarrollo local:      http://localhost:8000
# - Producción:            https://api.3psadecv.com  (cuando exista)
VITE_API_BASE_URL=http://localhost:8000

# EmailJS (formularios de contacto y reseñas)
VITE_EMAILJS_SERVICE_ID=service_3prclaq
VITE_EMAILJS_TEMPLATE_ID_REVIEWS=template_y153mic
VITE_EMAILJS_PUBLIC_KEY=bZ5Pz4T6UhA3cDcU1

# ---------------------------------------------------------------------------
# Backend CJ_OS Core API — variables de referencia
# Estas variables viven en api/.env, NO en el frontend.
# ---------------------------------------------------------------------------

# PostgreSQL (cj_assistant)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cj_assistant
POSTGRES_USER=cj_user
POSTGRES_PASSWORD=cambiar_en_api_env

# JWT
JWT_SECRET=cambiar_por_clave_jwt_segura_de_64_caracteres_minimo

# CORS
CORS_ORIGINS=http://localhost:5173,https://3psadecv.com

